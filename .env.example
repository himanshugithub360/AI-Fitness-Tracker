# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Public site URL (used for auth redirects). Use your Vercel preview URL when deployed.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The anon / publishable key. Safe for the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The service role / secret key. Server only. Never expose it in browser code.
SUPABASE_SERVICE_ROLE_KEY=

# AI providers (server only)
# Google AI Studio: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# Mistral La Plateforme: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# Optional settings
# Successful AI calls allowed per user in any rolling 24 hours (default 100).
AI_DAILY_LIMIT=100
# Set to true to allow developer pages such as /dev/ai on a deployed preview. They answer
# 404 in production without it. Always available in local development.
ENABLE_DEV_PAGES=false
# Swap AI models without code changes. Defaults work on free keys. On paid plans try:
# AI_MODEL_MISTRAL_SMALL=mistral-small-latest
# AI_MODEL_MISTRAL_MEDIUM=mistral-medium-latest
# AI_MODEL_GEMINI_PRO=gemini-pro-latest
