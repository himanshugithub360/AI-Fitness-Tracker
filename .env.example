# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Public site URL (used for auth redirects). Use your Vercel preview URL when deployed.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The anon / publishable key. Safe for the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The service role / secret key. Server only. Never expose it in browser code.
SUPABASE_SERVICE_ROLE_KEY=

# AI providers (server only)
# Google AI Studio: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# Mistral La Plateforme: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
